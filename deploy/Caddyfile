# §10.4 — the host's reverse proxy. Caddy gets a Let's Encrypt cert
# automatically (HTTP-01). Behind CGNAT, use a Cloudflare/Tailscale tunnel
# instead and point it at 127.0.0.1:8000 (§10.2.1).

api.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:8000

	# The API already sets Cache-Control: public, max-age=3600 on /api/*.
	# Nudge shared caches a little further and keep them honest on errors.
	header /api/* {
		Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
	}

	# Light rate limit — every response is a precomputed read, but a public
	# unauthenticated endpoint still wants a ceiling. (needs the
	# caddy-ratelimit plugin; drop this block if you build stock Caddy.)
	# rate_limit {
	# 	zone api { key {remote_host}  events 120  window 1m }
	# }

	log {
		output file /var/log/caddy/insyn.log
		format json
	}
}
