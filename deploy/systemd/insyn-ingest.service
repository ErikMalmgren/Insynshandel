# §10.3 / §10.4 rule 3 — the ingest runs from the host scheduler, one-shot,
# never a sleeping container. Install into /etc/systemd/system/, adjust
# WorkingDirectory + User, then:
#
#   systemctl enable --now insyn-ingest.timer
#   systemctl start insyn-ingest.service      # run once by hand
#   journalctl -u insyn-ingest -f

[Unit]
Description=Insynshandel ingest + build + export
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=insyn
WorkingDirectory=/opt/insynshandel
# EnvironmentFile=/opt/insynshandel/.env      # OPENFIGI_API_KEY, INSYN_CORS_ORIGINS
ExecStart=/opt/insynshandel/deploy/ingest.sh
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
