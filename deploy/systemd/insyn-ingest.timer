# §10.3 cadence. Business hours only — insider reports are filed on weekdays,
# so an overnight poll is requests that never find anything.

[Unit]
Description=Run the Insynshandel ingest on FI's publishing schedule

[Timer]
# hourly, 06:00–20:00, Mon–Fri, Europe/Stockholm
OnCalendar=Mon..Fri 06..20:00 Europe/Stockholm
# one nightly deep run — deploy/ingest.sh switches to gaps + 90-day at 03:xx
OnCalendar=*-*-* 03:00 Europe/Stockholm
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
