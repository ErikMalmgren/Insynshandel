# Copy to .env for the Docker deployment (§10.2, §10.4). .env is gitignored.

# Frontend origin(s) allowed to call the API, comma-separated. NEVER "*" (§1.2).
INSYN_CORS_ORIGINS=https://erikmalmgren.github.io

# Optional — raises the OpenFIGI rate limit (thousands of ISINs on first run).
# OPENFIGI_API_KEY=

# The image already sets INSYN_DATA_DIR=/data (DB + cache on the mounted volume).
